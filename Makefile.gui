$(GUI_APP_EXE): $(GUI_APP_OBJS) $(GUI_ARCHIVE) $(CORE_LIBRARY)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(GUI_MODE_FLAGS) $^ $(GUI_QT_LIBS) -o $@

$(GUI_TEST_BIN): $(GUI_TEST_OBJS) $(GUI_ARCHIVE) $(CORE_LIBRARY)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(GUI_MODE_FLAGS) $^ $(GUI_TEST_LIBS) -o $@

$(CORE_LIBRARY):
	$(MAKE) -f Makefile library-static LIB_MODE=$(GUI_MODE) \
		BUILDROOT=$(CORE_BUILDROOT)

$(GUI_LINKCHECK): $(GUI_OBJ_DIR)/tests/GuiLinkCheck.o $(GUI_ARCHIVE) \
		$(CORE_LIBRARY)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXSTD) $(GUI_MODE_FLAGS) $^ $(GUI_QT_LIBS) -o $@

-include $(GUI_ARCHIVE_OBJS:.o=.d) $(GUI_TEST_OBJS:.o=.d) \
	$(GUI_APP_OBJS:.o=.d) $(GUI_OBJ_DIR)/tests/GuiLinkCheck.d

