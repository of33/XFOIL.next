$(GUI_ARCHIVE): $(GUI_ARCHIVE_OBJS)
	@mkdir -p $(dir $@)
	rm -f $@
	$(AR) rcs $@ $(GUI_ARCHIVE_OBJS)

$(GUI_APP_MAIN_OBJ): src/gui/app/main.cpp src/gui/app/MainWindow.h \
		src/app/ProductInfo.h | $(GUI_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_FLAGS) -MMD -MP -c $< -o $@

$(GUI_OBJ_DIR)/app/MainWindow.o: src/gui/app/MainWindow.cpp \
		src/gui/app/MainWindow.h src/gui/app/GuiFileAdapters.h \
		include/xfoil/gui/XFoilWidget.h | $(GUI_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_FLAGS) $(QCP_WARNINGS) -I$(QCP_DIR) -MMD -MP -c $< -o $@

