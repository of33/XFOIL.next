# File: Makefile.gui
# Optional Qt GUI skeleton build. This file is deliberately separate from the
# core Makefile: no default target in the root Makefile requires Qt.

SHELL := /bin/sh
CXX ?= g++
AR ?= ar

CXXSTD := -std=c++20 -pthread
BUILDROOT ?= build
BINROOT ?= bin
GUI_BUILDROOT ?= $(BUILDROOT)/gui
GUI_MODE ?= debug
CORE_BUILDROOT ?= $(BUILDROOT)

# Reserved canonical product paths for the future GUI executable. G2c does
# not build or create either file; the GUI archive and tests stay below
# build/gui/. G5 will link these reserved names from the GUI archive.
ifeq ($(OS),Windows_NT)
GUI_EXE_SUFFIX := .exe
else ifneq (,$(filter Msys Cygwin,$(shell uname -o 2>/dev/null)))
GUI_EXE_SUFFIX := .exe
else
GUI_EXE_SUFFIX :=
endif
GUI_DEBUG_EXE := $(BINROOT)/debug/xfoil.next-gui$(GUI_EXE_SUFFIX)
GUI_RELEASE_EXE := $(BINROOT)/release/xfoil.next-gui$(GUI_EXE_SUFFIX)

GUI_TOOLCHAIN := $(shell printf '%s' "$(CXX)" | md5sum | cut -c1-8)
QT_ROOT ?=
QT_PC_PREFIX := $(shell pkg-config --variable=prefix Qt6Core 2>/dev/null)
ifeq ($(strip $(QT_ROOT)),)
QT_ROOT := $(QT_PC_PREFIX)
endif
QT_QMAKE := $(firstword $(wildcard $(QT_ROOT)/bin/qmake6 $(QT_ROOT)/bin/qmake))
ifeq ($(strip $(QT_QMAKE)),)
QT_QMAKE := $(shell command -v qmake6 2>/dev/null || command -v qmake 2>/dev/null)
endif
ifeq ($(strip $(QT_ROOT)),)
QT_ROOT := $(shell $(QT_QMAKE) -query QT_INSTALL_PREFIX 2>/dev/null)
endif
QT_VERSION := $(shell $(QT_QMAKE) -query QT_VERSION 2>/dev/null)
ifeq ($(strip $(QT_VERSION)),)
QT_VERSION := $(shell sed -n 's/^#define QTCORE_VERSION_STR "\([^"]*\)"/\1/p' \
	$(QT_ROOT)/include/QtCore/qtcoreversion.h 2>/dev/null)
endif
QT_INCLUDE_DIR := $(shell $(QT_QMAKE) -query QT_INSTALL_HEADERS 2>/dev/null)
QT_LIB_DIR := $(shell $(QT_QMAKE) -query QT_INSTALL_LIBS 2>/dev/null)
QT_PLUGIN_DIR := $(shell $(QT_QMAKE) -query QT_INSTALL_PLUGINS 2>/dev/null)
QT_LIBEXECS := $(shell $(QT_QMAKE) -query QT_INSTALL_LIBEXECS 2>/dev/null)
QT_HOST_BINS := $(shell $(QT_QMAKE) -query QT_HOST_BINS 2>/dev/null)
ifeq ($(strip $(QT_INCLUDE_DIR)),)
QT_INCLUDE_DIR := $(QT_ROOT)/include
endif
ifeq ($(strip $(QT_LIB_DIR)),)
QT_LIB_DIR := $(QT_ROOT)/lib
endif
ifeq ($(strip $(QT_PLUGIN_DIR)),)
QT_PLUGIN_DIR := $(QT_ROOT)/plugins
endif
QT_MOC := $(firstword $(wildcard \
	$(QT_LIBEXECS)/moc $(QT_LIBEXECS)/moc.exe \
	$(QT_HOST_BINS)/moc $(QT_HOST_BINS)/moc.exe \
	$(QT_ROOT)/libexec/moc $(QT_ROOT)/bin/moc \
	$(QT_ROOT)/libexec/moc.exe $(QT_ROOT)/bin/moc.exe \
	$(QT_ROOT)/share/qt6/bin/moc.exe))
QT_UIC := $(firstword $(wildcard \
	$(QT_LIBEXECS)/uic $(QT_LIBEXECS)/uic.exe \
	$(QT_HOST_BINS)/uic $(QT_HOST_BINS)/uic.exe \
	$(QT_ROOT)/libexec/uic $(QT_ROOT)/bin/uic \
	$(QT_ROOT)/libexec/uic.exe $(QT_ROOT)/bin/uic.exe \
	$(QT_ROOT)/share/qt6/bin/uic.exe))
QT_KIT_TAG := $(shell printf '%s' "$(QT_ROOT)" | md5sum | cut -c1-8)
GUI_VARIANT := $(GUI_TOOLCHAIN)-$(QT_KIT_TAG)

GUI_MODE_DIR := $(GUI_BUILDROOT)/$(GUI_MODE)
GUI_GEN_DIR := $(GUI_MODE_DIR)/gen/$(GUI_VARIANT)
GUI_OBJ_DIR := $(GUI_MODE_DIR)/obj/$(GUI_VARIANT)
GUI_LIB_DIR := $(GUI_MODE_DIR)/lib
GUI_TEST_DIR := $(GUI_MODE_DIR)/tests
GUI_STAMP := $(GUI_MODE_DIR)/.qt-$(GUI_VARIANT).stamp

ifeq ($(GUI_MODE),release)
GUI_MODE_FLAGS := -O3 -DNDEBUG -DQT_NO_DEBUG
else
GUI_MODE_FLAGS := -O0 -g3
endif

# Qt headers are not clean under -Wconversion/-Wsign-conversion and
# QCustomPlot 2.1.1 uses old-style casts. Keep -Werror, but use the Qt-safe
# subset for the optional GUI path only. Core and CLI builds retain the full
# warning set.
GUI_WARNINGS := \
	-Wall \
	-Wextra \
	-Wpedantic \
	-Wnon-virtual-dtor \
	-Woverloaded-virtual \
	-Wformat=2 \
	-Werror

QT_SYSTEM_INCLUDES := \
	-isystem $(QT_INCLUDE_DIR) \
	-isystem $(QT_INCLUDE_DIR)/QtCore \
	-isystem $(QT_INCLUDE_DIR)/QtGui \
	-isystem $(QT_INCLUDE_DIR)/QtWidgets \
	-isystem $(QT_INCLUDE_DIR)/QtPrintSupport \
	-isystem $(QT_INCLUDE_DIR)/QtSvg \
	-isystem $(QT_INCLUDE_DIR)/QtTest
QT_MOC_INCLUDES := \
	-I$(QT_INCLUDE_DIR) \
	-I$(QT_INCLUDE_DIR)/QtCore \
	-I$(QT_INCLUDE_DIR)/QtGui \
	-I$(QT_INCLUDE_DIR)/QtWidgets \
	-I$(QT_INCLUDE_DIR)/QtPrintSupport \
	-I$(QT_INCLUDE_DIR)/QtSvg \
	-I$(QT_INCLUDE_DIR)/QtTest
QT_DEFINES := \
	-DQT_CORE_LIB \
	-DQT_GUI_LIB \
	-DQT_WIDGETS_LIB \
	-DQT_PRINTSUPPORT_LIB \
	-DQT_SVG_LIB \
	-DQT_TESTLIB_LIB
GUI_INCLUDES := -I. -Iinclude -Isrc -Isrc/gui -I$(GUI_GEN_DIR) $(QT_SYSTEM_INCLUDES)
GUI_FLAGS := $(CXXSTD) $(GUI_INCLUDES) $(QT_DEFINES) $(GUI_WARNINGS) \
	$(GUI_MODE_FLAGS) -fPIC
GUI_MOC_FLAGS := $(QT_DEFINES) -Iinclude -Isrc -Isrc/gui $(QT_MOC_INCLUDES)
GUI_QT_LIBS := -L$(QT_LIB_DIR) -lQt6Widgets -lQt6Gui -lQt6Core \
	-lQt6PrintSupport -lQt6Svg
GUI_TEST_LIBS := $(GUI_QT_LIBS) -lQt6Test

QCP_DIR := src/gui/3rdparty/qcustomplot-2.1.1
# QCustomPlot 2.1.1 still uses the Qt 5 Q_ENUMS/Q_FLAGS macros. Qt 6.12
# marks those macros deprecated, and Clang also reports two legacy
# indentation sites. Limit both suppressions to the vendored QCP
# translation units; project code keeps the full warning set.
QCP_WARNINGS := -Wno-deprecated-pragma -Wno-misleading-indentation
GUI_ARCHIVE := $(GUI_LIB_DIR)/$(GUI_VARIANT)/libxfoil_next_gui.a
GUI_ARCHIVE_OBJS := \
	$(GUI_OBJ_DIR)/XFoilWidget.o \
	$(GUI_OBJ_DIR)/moc_XFoilWidget.o \
	$(GUI_OBJ_DIR)/model/GuiDefinitionModel.o \
	$(GUI_OBJ_DIR)/model/GuiPolarManager.o \
	$(GUI_OBJ_DIR)/model/GuiResultSelectionModel.o \
	$(GUI_OBJ_DIR)/model/GuiResultSummary.o \
	$(GUI_OBJ_DIR)/backend/GuiSessionBackend.o \
	$(GUI_OBJ_DIR)/worker/GuiAnalysisWorker.o \
	$(GUI_OBJ_DIR)/moc_GuiAnalysisWorker.o \
	$(GUI_OBJ_DIR)/plots/GeometryPlotView.o \
	$(GUI_OBJ_DIR)/plots/GuiPointPresentation.o \
	$(GUI_OBJ_DIR)/plots/InteractivePlotController.o \
	$(GUI_OBJ_DIR)/plots/ResultPlotView.o \
	$(GUI_OBJ_DIR)/plots/ScalarPlotView.o \
	$(GUI_OBJ_DIR)/moc_qcustomplot.o \
	$(GUI_OBJ_DIR)/qcustomplot.o
GUI_APP_MAIN_OBJ := $(GUI_OBJ_DIR)/app/main.o
GUI_APP_COMMON_OBJS := \
	$(GUI_OBJ_DIR)/app/MainWindow.o \
	$(GUI_OBJ_DIR)/app/GuiFileAdapters.o \
	$(GUI_OBJ_DIR)/app/DatFileReader.o \
	$(GUI_OBJ_DIR)/app/AirfoilWriter.o
GUI_APP_OBJS := $(GUI_APP_MAIN_OBJ) $(GUI_APP_COMMON_OBJS)
GUI_APP_EXE := $(if $(filter release,$(GUI_MODE)),$(GUI_RELEASE_EXE),$(GUI_DEBUG_EXE))
GUI_TEST_BIN := $(GUI_TEST_DIR)/$(GUI_VARIANT)/xfoil_gui_tests$(GUI_EXE_SUFFIX)
GUI_TEST_OBJS := \
	$(GUI_OBJ_DIR)/tests/GuiTestMain.o \
	$(GUI_OBJ_DIR)/tests/QCustomPlotSmoke.o \
	$(GUI_OBJ_DIR)/tests/GeometryPlotViewTests.o \
	$(GUI_OBJ_DIR)/tests/GuiDefinitionModelTests.o \
	$(GUI_OBJ_DIR)/tests/GuiPolarManagerTests.o \
	$(GUI_OBJ_DIR)/tests/GuiResultSelectionModelTests.o \
	$(GUI_OBJ_DIR)/tests/GuiResultSummaryTests.o \
	$(GUI_OBJ_DIR)/tests/GuiResultWorkspaceTests.o \
	$(GUI_OBJ_DIR)/tests/GuiScalarPlotTests.o \
	$(GUI_OBJ_DIR)/tests/GuiDistributionPlotTests.o \
	$(GUI_OBJ_DIR)/tests/GuiPlotInteractionTests.o \
	$(GUI_OBJ_DIR)/tests/GuiDetailedSequenceContractTests.o \
	$(GUI_OBJ_DIR)/tests/GuiSessionBackendTests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG2Tests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG3Tests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG4Tests.o \
	$(GUI_OBJ_DIR)/tests/GuiAnalysisWorkerTests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG6bTests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG6cTests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetG6dTests.o \
	$(GUI_OBJ_DIR)/tests/XFoilWidgetShellTests.o \
	$(GUI_OBJ_DIR)/tests/app/GuiFileAdaptersTests.o \
	$(GUI_OBJ_DIR)/tests/app/MainWindowTests.o \
	$(GUI_APP_COMMON_OBJS)
GUI_LINKCHECK := $(GUI_TEST_DIR)/$(GUI_VARIANT)/gui-link-check$(GUI_EXE_SUFFIX)
ifeq ($(GUI_EXE_SUFFIX),.exe)
CORE_STATIC_NAME := libxfoil_next_static.a
else
CORE_STATIC_NAME := libxfoil_next.a
endif
CORE_LIBRARY := $(CORE_BUILDROOT)/$(GUI_MODE)/lib/$(CORE_STATIC_NAME)

.PHONY: all gui gui-debug gui-release gui-app gui-app-debug \
	gui-app-release gui-app-bin run-gui test-gui gui-qcustomplot-check \
	gui-link-check clean check-gui-dependencies

all: gui

gui: $(GUI_ARCHIVE)

gui-app: gui-app-debug gui-app-release

gui-app-debug:
	$(MAKE) -f Makefile.gui gui-app-bin GUI_MODE=debug

gui-app-release:
	$(MAKE) -f Makefile.gui gui-app-bin GUI_MODE=release

gui-app-bin: $(GUI_APP_EXE)

run-gui: gui-app-debug
	LD_LIBRARY_PATH="$(QT_LIB_DIR):$${LD_LIBRARY_PATH:-}" \
	QT_PLUGIN_PATH="$(QT_PLUGIN_DIR)" \
	QT_QPA_PLATFORM_PLUGIN_PATH="$(QT_PLUGIN_DIR)/platforms" \
	$(GUI_DEBUG_EXE)

gui-debug:
	$(MAKE) -f Makefile.gui gui GUI_MODE=debug

gui-release:
	$(MAKE) -f Makefile.gui gui GUI_MODE=release

test-gui: $(GUI_TEST_BIN)
	LD_LIBRARY_PATH="$(QT_LIB_DIR):$${LD_LIBRARY_PATH:-}" \
	QT_QPA_PLATFORM=offscreen \
	QT_PLUGIN_PATH="$(QT_PLUGIN_DIR)" \
	QT_QPA_PLATFORM_PLUGIN_PATH="$(QT_PLUGIN_DIR)/platforms" \
	$(GUI_TEST_BIN)

gui-qcustomplot-check: $(GUI_TEST_BIN)
	@cd $(QCP_DIR) && sha256sum --check SHA256SUMS
	LD_LIBRARY_PATH="$(QT_LIB_DIR):$${LD_LIBRARY_PATH:-}" \
	QT_QPA_PLATFORM=offscreen \
	QT_PLUGIN_PATH="$(QT_PLUGIN_DIR)" \
	QT_QPA_PLATFORM_PLUGIN_PATH="$(QT_PLUGIN_DIR)/platforms" \
	$(GUI_TEST_BIN)

gui-link-check: $(GUI_LINKCHECK)
	LD_LIBRARY_PATH="$(QT_LIB_DIR):$${LD_LIBRARY_PATH:-}" \
	QT_QPA_PLATFORM=offscreen \
	QT_PLUGIN_PATH="$(QT_PLUGIN_DIR)" \
	QT_QPA_PLATFORM_PLUGIN_PATH="$(QT_PLUGIN_DIR)/platforms" \
	$(GUI_LINKCHECK)

check-gui-dependencies:
	python3 tools/check-gui-dependencies.py

clean:
	rm -rf $(GUI_BUILDROOT)
	rm -f $(GUI_DEBUG_EXE) $(GUI_RELEASE_EXE)

$(GUI_STAMP):
	@mkdir -p $(dir $@)
	@set -e; \
		if [ -z "$(QT_ROOT)" ]; then \
			echo "ERROR: Qt 6.12.x not found. Set QT_ROOT to the Qt kit prefix."; \
			exit 1; \
		fi; \
		test -d "$(QT_INCLUDE_DIR)/QtCore"; \
		test -x "$(QT_MOC)"; \
		test -x "$(QT_UIC)"; \
		case "$(QT_VERSION)" in \
			6.12.*) ;; \
			*) echo "ERROR: Qt 6.12.x required, found '$(QT_VERSION)'"; exit 1 ;; \
		esac; \
		for module in Core Gui Widgets PrintSupport Test; do \
			test -d "$(QT_INCLUDE_DIR)/Qt$$module" || { \
				echo "ERROR: missing Qt module: $$module"; exit 1; }; \
		done; \
		for lib in Qt6Core Qt6Gui Qt6Widgets Qt6PrintSupport Qt6Test; do \
			if ls "$(QT_LIB_DIR)"/lib$$lib.so* >/dev/null 2>&1 \
			   || test -f "$(QT_LIB_DIR)/lib$$lib.dll.a"; then :; \
			else \
				echo "ERROR: missing Qt library: $$lib"; exit 1; \
			fi; \
		done; \
		printf 'QT_ROOT=%s\nQT_VERSION=%s\n' \
			"$(QT_ROOT)" "$(QT_VERSION)" > "$@"

$(GUI_GEN_DIR) $(GUI_LIB_DIR) $(GUI_TEST_DIR):
	@mkdir -p $@

$(GUI_GEN_DIR)/ui_XFoilWidget.h: src/gui/XFoilWidget.ui | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_UIC) $< -o $@

$(GUI_GEN_DIR)/moc_XFoilWidget.cpp: include/xfoil/gui/XFoilWidget.h | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) $< -o $@

$(GUI_GEN_DIR)/moc_GuiAnalysisWorker.cpp: src/gui/worker/GuiAnalysisWorker.h | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) $< -o $@

$(GUI_GEN_DIR)/moc_qcustomplot.cpp: $(QCP_DIR)/qcustomplot.h | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) -I$(QCP_DIR) $< -o $@

$(GUI_GEN_DIR)/%.moc: tests/gui/%.cpp | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) $< -o $@

$(GUI_GEN_DIR)/GuiFileAdaptersTests.moc: \
		tests/gui/app/GuiFileAdaptersTests.cpp | $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) $< -o $@

$(GUI_GEN_DIR)/MainWindowTests.moc: tests/gui/app/MainWindowTests.cpp \
		| $(GUI_GEN_DIR) $(GUI_STAMP)
	$(QT_MOC) $(GUI_MOC_FLAGS) $< -o $@

$(GUI_OBJ_DIR)/XFoilWidget.o: src/gui/XFoilWidget.cpp \
		include/xfoil/gui/XFoilWidget.h \
		include/xfoil/gui/AnalysisWorkflowSetup.h \
		src/gui/model/GuiDefinitionModel.h \
		src/gui/model/GuiPolarManager.h \
		src/gui/worker/GuiAnalysisWorker.h \
		$(GUI_GEN_DIR)/ui_XFoilWidget.h | $(GUI_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_FLAGS) $(QCP_WARNINGS) -I$(QCP_DIR) -MMD -MP -c $< -o $@

$(GUI_OBJ_DIR)/model/GuiDefinitionModel.o: \
		src/gui/model/GuiDefinitionModel.cpp \
		src/gui/model/GuiDefinitionModel.h \
		src/gui/model/GuiRunSpec.h | $(GUI_STAMP)
	@mkdir -p $(dir $@)
	$(CXX) $(GUI_FLAGS) -MMD -MP -c $< -o $@

$(GUI_OBJ_DIR)/model/GuiPolarManager.o: \
