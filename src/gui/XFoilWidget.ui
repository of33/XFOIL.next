      <string>
QPushButton#analyzeButton[analysisState="disabled"] { background-color: #d9d9d9; color: #666666; }
QPushButton#analyzeButton[analysisState="ready"] { background-color: #2e7d32; color: white; font-weight: 600; }
QPushButton#analyzeButton[analysisState="running"] { background-color: #c62828; color: white; font-weight: 600; }
QPushButton#analyzeButton[analysisState="cancelling"] { background-color: #c62828; color: #f5f5f5; font-weight: 600; }
