
# XFOIL-6.99-Prompts enden absichtlich mit zwei Leerzeichen.
# Die CLI-Transkripte werden bytegenau verglichen.
tests/golden/cli/*.stdout.txt -whitespace

# S11 polar fixtures are byte-exact Fortran text with fixed-width
# trailing spaces.
tests/data/xfoil-6.996/s11/*.pol -whitespace

# S13 boundary-layer fixtures keep fixed-width header trailing spaces.
tests/data/xfoil-6.996/s13/*.bl -whitespace

# Keep public text artifacts byte-stable across POSIX and Windows checkouts.
* text=auto eol=lf

# Windows command scripts are intentionally checked out with CRLF.
*.bat text eol=crlf

