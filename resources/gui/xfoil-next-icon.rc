// XFOIL.next native Windows application icon and version resource.
// The ICO is derived proportionally from the owner-approved canonical source
// resources/gui/Airfoil.Next_icon.png. The version values are supplied from
// the canonical src/app/ProductInfo.h by Makefile.gui. Compiled with windres
// for the standalone GUI application target only.
#include "xfoil-next-version.h"
1 ICON "xfoil-next-icon.ico"

1 VERSIONINFO
FILEVERSION XFOIL_GUI_VERSION_MAJOR,XFOIL_GUI_VERSION_MINOR,XFOIL_GUI_VERSION_PATCH,0
PRODUCTVERSION XFOIL_GUI_VERSION_MAJOR,XFOIL_GUI_VERSION_MINOR,XFOIL_GUI_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "XFOIL.next"
      VALUE "FileDescription", "XFOIL.next GUI"
      VALUE "FileVersion", XFOIL_GUI_VERSION_STRING
      VALUE "InternalName", "XFOIL.next GUI"
      VALUE "LegalCopyright", "Copyright (C) 2026 Olaf Frommann"
      VALUE "OriginalFilename", "xfoil.next.exe"
      VALUE "ProductName", "XFOIL.next GUI"
      VALUE "ProductVersion", XFOIL_GUI_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
